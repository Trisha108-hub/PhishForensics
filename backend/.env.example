# === PhishGuard API Configuration ===
# Copy this file to ".env" and fill in whichever keys you have.
# Any missing key just means that module falls back to heuristics-only mode.

PORT=4000

# VirusTotal (file/URL/domain reputation) - https://www.virustotal.com/gui/join-us
VT_API_KEY=

# URLScan.io (live URL sandboxing / screenshots) - https://urlscan.io/user/signup
URLSCAN_API_KEY=

# AbuseIPDB (sending-IP reputation) - https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Google Safe Browsing (URL blocklist check) - https://developers.google.com/safe-browsing
SAFE_BROWSING_API_KEY=

# Have I Been Pwned (optional - domain breach context) - https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Default password used to encrypt generated PDF reports if the user doesn't set one at export time
DEFAULT_REPORT_PASSWORD=ChangeMe123!
